      "value": 0.15,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M02",
      "name": "Flower_Freshness_Index",
      "description": "Индекс свежести используемых цветов, на основе отзывов и поставщиков.",
      "value": 0.2,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M03",
      "name": "Supplier_Diversity_Ratio",
      "description": "Разнообразие поставщиков цветов для снижения зависимости.",
      "value": 0.1,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M04",
      "name": "Customer_Service_Responsiveness_Score",
      "description": "Оценка оперативности и качества ответов службы поддержки.",
      "value": 0.15,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M05",
      "name": "Florist_Expertise_Index",
      "description": "Индекс квалификации и опыта флористов компании.",
      "value": 0.15,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M06",
      "name": "Website_Conversion_Capacity",
      "description": "Эффективность сайта в конвертации посетителей в покупателей.",
      "value": 0.1,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M07",
      "name": "Logistics_Optimization_Ratio",
      "description": "Оценка эффективности логистических маршрутов и управления доставкой.",
      "value": 0.05,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M08",
      "name": "Refund_Rate_Penalty",
      "description": "Штраф за высокий процент возвратов и отмен заказов.",
